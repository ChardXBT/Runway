# Runway environment template
# Copy this file to .env and replace only the values you intend to use.
# Never commit .env, API keys, passwords, cookies, or browser-profile data.

# -----------------------------------------------------------------------------
# Channel and schedule
# -----------------------------------------------------------------------------
RUNWAY_PRODUCT_NAME=Runway
RUNWAY_CHANNEL_NAME=Qlob
RUNWAY_CHANNEL_HANDLE=Qlob
RUNWAY_TIMEZONE=America/Toronto
RUNWAY_DEFAULT_POST_TIME=10:00
RUNWAY_POSTS_PER_DAY=1
RUNWAY_DUPLICATE_WINDOW_DAYS=180
RUNWAY_APPROVAL_REQUIRED=true
RUNWAY_CAPTION_QUESTION_FIRST=true

# Assisted preparation is the default and never requires a saved browser session.
# Authorized browser publishing is available only from the explicit Lineup action
# and requires all three settings below. Generator Accept remains local-only.
RUNWAY_PUBLISHING_MODE=assisted
RUNWAY_PUBLISHING_ENABLED=false
RUNWAY_YOUTUBE_AUTOMATION_AUTHORIZED=false
RUNWAY_PUBLISHER_CHANNEL_ID=UCQ-nHijGwxNU3Go_wyLQ5Ng
RUNWAY_PUBLISHER_CONFIRMATION_TTL_MINUTES=10
# Manual account sign-in opens ordinary installed Google Chrome with Runway's
# isolated profile. Later guarded actions reopen that profile through Chrome.
RUNWAY_PUBLISHER_BROWSER_CHANNEL=chrome
# Usually auto-detected. Set an absolute chrome.exe path only if needed.
RUNWAY_PUBLISHER_CHROME_PATH=

# -----------------------------------------------------------------------------
# Local storage and servers
# -----------------------------------------------------------------------------
RUNWAY_DATA_DIR=data
RUNWAY_HOST=127.0.0.1
RUNWAY_API_PORT=8000
RUNWAY_WEB_PORT=3000
NEXT_PUBLIC_RUNWAY_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Historical YouTube capture
# -----------------------------------------------------------------------------
# Capture uses a visible Chromium window and a persistent local browser profile.
# Google/YouTube passwords are deliberately not environment variables.
RUNWAY_CAPTURE_SCROLL_DELAY_MS=1800
# YouTube can pause at a pagination boundary for several seconds. Runway only
# treats the feed as exhausted after both this many unchanged probes and the
# sustained quiet period below.
RUNWAY_CAPTURE_IDLE_CYCLES_BEFORE_STOP=30
RUNWAY_CAPTURE_IDLE_SECONDS_BEFORE_STOP=90
RUNWAY_CAPTURE_CHECKPOINT_EVERY=10

# -----------------------------------------------------------------------------
# ChatGPT-plan Codex analysis and caption generation
# -----------------------------------------------------------------------------
# Codex runs through the official project-local CLI and reuses `codex login`.
# Runway requires "Logged in using ChatGPT", strips API-key environment values,
# serializes jobs, and stops on authentication or included-usage-limit errors.
RUNWAY_AGENT_RUNTIME=codex
RUNWAY_CODEX_CLI_PATH=
RUNWAY_CODEX_MODEL=gpt-5.6-luna
RUNWAY_CODEX_REASONING_EFFORT=low
RUNWAY_CODEX_TIMEOUT_SECONDS=300
# Five posts per structured request reduces ChatGPT-plan usage overhead while
# keeping image-to-post mapping small enough for reliable visual annotation.
RUNWAY_ANALYSIS_BATCH_SIZE=5

# Optional explicit paid API runtime. Runway never falls back to it. Leave these
# blank for the ChatGPT-plan Codex configuration.
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Versioned intelligence representations
# -----------------------------------------------------------------------------
# The deterministic `runway-local` providers are the safe production defaults.
# Optional trained adapters never download weights, never auto-activate, and
# require a trusted local model directory plus the `intelligence-ml` extra.
RUNWAY_TEXT_EMBEDDING_PROVIDER=runway-local
RUNWAY_TEXT_EMBEDDING_MODEL_PATH=
RUNWAY_TEXT_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
RUNWAY_TEXT_EMBEDDING_MODEL_REVISION=unvalidated-local
RUNWAY_MULTIMODAL_EMBEDDING_PROVIDER=runway-local
RUNWAY_MULTIMODAL_EMBEDDING_MODEL_PATH=
RUNWAY_MULTIMODAL_EMBEDDING_MODEL_ID=google/siglip2-base-patch16-224
RUNWAY_MULTIMODAL_EMBEDDING_MODEL_REVISION=unvalidated-local
RUNWAY_EMBEDDING_DEVICE=cpu
RUNWAY_EMBEDDING_BATCH_SIZE=8

# -----------------------------------------------------------------------------
# Image discovery
# -----------------------------------------------------------------------------
# Experimental headed browser search. It may require manual challenge handling.
# Copyright/licensing is retained as provenance and does not veto discovery.
# Explicitly sexual/NSFW sources and images are always rejected.
RUNWAY_ENABLE_BROWSER_SEARCH=false
RUNWAY_BROWSER_SEARCH_URL=https://www.bing.com/images/search?q={query}&safeSearch=Strict
# Hard request caps keep one headed-search run bounded. Lower them for a smoke
# test; raise them deliberately only after reviewing ChatGPT-plan usage.
RUNWAY_BROWSER_SEARCH_MAX_QUERIES=6
RUNWAY_BROWSER_SEARCH_RESULTS_PER_QUERY=3
RUNWAY_BROWSER_SEARCH_MAX_RESULTS=18
# Keep the learned primary channel topic dominant while rotating through
# explicit creator-approved secondary topics. Leave secondary topics blank
# for channels that should follow their historical topic distribution only.
RUNWAY_DISCOVERY_PRIMARY_TOPIC_QUERY_SHARE=0.8
RUNWAY_DISCOVERY_SECONDARY_TOPICS=

# Optional custom search-provider adapter. Leave blank unless a compatible
# provider endpoint has been selected and integrated.
RUNWAY_SEARCH_API_URL=
RUNWAY_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Image quality and duplicate protection
# -----------------------------------------------------------------------------
RUNWAY_MINIMUM_IMAGE_DIMENSION=480
RUNWAY_MAXIMUM_IMAGE_BYTES=20971520
RUNWAY_DUPLICATE_PERCEPTUAL_THRESHOLD=0.94
RUNWAY_DUPLICATE_SEMANTIC_THRESHOLD=0.99
RUNWAY_CAPTION_DUPLICATE_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# YouTube publishing credentials
# -----------------------------------------------------------------------------
# No passwords, cookies, API tokens, or Google credentials belong here. The
# guarded publisher uses data/browser-profile/publisher and manual sign-in in
# ordinary Google Chrome with the Qlob Editor account. Keep that profile local
# and ignored by Git. Never lower Google account security to make sign-in work.
