# Leeway is safe and fully functional with the mock runtime and fixture provider.
LEWAY_DATA_DIR=data
LEWAY_HOST=127.0.0.1
LEWAY_API_PORT=8000
LEWAY_WEB_PORT=3000
LEWAY_AGENT_RUNTIME=mock

# Real model calls are disabled unless both values are set deliberately.
OPENAI_API_KEY=
OPENAI_MODEL=

# Live browser search is experimental, headed, and always user initiated.
LEWAY_ENABLE_BROWSER_SEARCH=false
LEWAY_BROWSER_SEARCH_URL=https://www.google.com/search?tbm=isch&q={query}

# Optional provider adapter. No provider is assumed or enabled by default.
LEWAY_SEARCH_API_URL=
LEWAY_SEARCH_API_KEY=

NEXT_PUBLIC_LEEWAY_API_URL=http://127.0.0.1:8000
