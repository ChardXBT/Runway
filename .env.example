# Runway environment template
# Copy this file to .env and replace only the values you intend to use.
# Never commit .env, API keys, passwords, cookies, or browser-profile data.

# -----------------------------------------------------------------------------
# Channel and schedule
# -----------------------------------------------------------------------------
RUNWAY_PRODUCT_NAME=Runway
RUNWAY_CHANNEL_NAME=Qlob
RUNWAY_CHANNEL_HANDLE=Qlob
# Google account the connector/publisher browser profile signs in as. Shown to
# the operator only; it is never used to log in programmatically.
RUNWAY_CONNECTOR_ACCOUNT_EMAIL=
RUNWAY_TIMEZONE=America/Toronto
RUNWAY_DEFAULT_POST_TIME=10:00
RUNWAY_POSTS_PER_DAY=1
RUNWAY_DUPLICATE_WINDOW_DAYS=180
RUNWAY_APPROVAL_REQUIRED=true
RUNWAY_CAPTION_QUESTION_FIRST=true

# Assisted preparation is the default and never requires a saved browser session.
# Authorized browser publishing is available only from the explicit Lineup action
# and requires all three settings below. Generator Accept remains local-only.
RUNWAY_PUBLISHING_MODE=assisted
RUNWAY_PUBLISHING_ENABLED=false
RUNWAY_YOUTUBE_AUTOMATION_AUTHORIZED=false
RUNWAY_PUBLISHER_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
RUNWAY_PUBLISHER_CONFIRMATION_TTL_MINUTES=10
# Manual account sign-in opens ordinary installed Google Chrome with Runway's
# isolated profile. Later guarded actions reopen that profile through Chrome.
RUNWAY_PUBLISHER_BROWSER_CHANNEL=chrome
# Usually auto-detected. Set an absolute chrome.exe path only if needed.
RUNWAY_PUBLISHER_CHROME_PATH=

# -----------------------------------------------------------------------------
# Local storage and servers
# -----------------------------------------------------------------------------
# local (default): one owner, loopback only, no login. hosted is not runnable yet: it
# requires Postgres and an identity provider, and refuses the browser publisher.
RUNWAY_PROFILE=local
RUNWAY_IDENTITY_PROVIDER=
RUNWAY_DATA_DIR=data
RUNWAY_HOST=127.0.0.1
RUNWAY_API_PORT=8000
RUNWAY_WEB_PORT=3000
NEXT_PUBLIC_RUNWAY_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Historical YouTube capture
# -----------------------------------------------------------------------------
# Capture uses a visible Chromium window and a persistent local browser profile.
# Google/YouTube passwords are deliberately not environment variables.
RUNWAY_CAPTURE_SCROLL_DELAY_MS=1800
# YouTube can pause at a pagination boundary for several seconds. Runway only
# treats the feed as exhausted after both this many unchanged probes and the
# sustained quiet period below.
RUNWAY_CAPTURE_IDLE_CYCLES_BEFORE_STOP=30
RUNWAY_CAPTURE_IDLE_SECONDS_BEFORE_STOP=90
RUNWAY_CAPTURE_CHECKPOINT_EVERY=10

# -----------------------------------------------------------------------------
# ChatGPT-plan Codex analysis and caption generation
# -----------------------------------------------------------------------------
# Codex runs through the official project-local CLI and reuses `codex login`.
# Runway requires "Logged in using ChatGPT", strips API-key environment values,
# serializes jobs, and stops on authentication or included-usage-limit errors.
RUNWAY_AGENT_RUNTIME=codex
RUNWAY_CODEX_CLI_PATH=
RUNWAY_CODEX_MODEL=gpt-6-luna
RUNWAY_CODEX_REASONING_EFFORT=high
RUNWAY_CODEX_TIMEOUT_SECONDS=300
# Five posts per structured request reduces ChatGPT-plan usage overhead while
# keeping image-to-post mapping small enough for reliable visual annotation.
RUNWAY_ANALYSIS_BATCH_SIZE=5

# Optional explicit paid API runtime. Runway never falls back to it. Leave these
# blank for the ChatGPT-plan Codex configuration.
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Versioned intelligence representations
# -----------------------------------------------------------------------------
# The deterministic `runway-local` providers are the safe production defaults.
# Optional trained adapters never download weights, never auto-activate, and
# require a trusted local model directory plus the `intelligence-ml` extra.
RUNWAY_TEXT_EMBEDDING_PROVIDER=runway-local
RUNWAY_TEXT_EMBEDDING_MODEL_PATH=
RUNWAY_TEXT_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
RUNWAY_TEXT_EMBEDDING_MODEL_REVISION=unvalidated-local
RUNWAY_MULTIMODAL_EMBEDDING_PROVIDER=runway-local
RUNWAY_MULTIMODAL_EMBEDDING_MODEL_PATH=
RUNWAY_MULTIMODAL_EMBEDDING_MODEL_ID=google/siglip2-base-patch16-224
RUNWAY_MULTIMODAL_EMBEDDING_MODEL_REVISION=unvalidated-local
RUNWAY_EMBEDDING_DEVICE=cpu
RUNWAY_EMBEDDING_BATCH_SIZE=8

# -----------------------------------------------------------------------------
# Image discovery
# -----------------------------------------------------------------------------
# Experimental headed browser search. It may require manual challenge handling.
# Copyright/licensing is retained as provenance and does not veto discovery.
# Explicitly sexual/NSFW sources and images are always rejected.
RUNWAY_ENABLE_BROWSER_SEARCH=false
RUNWAY_BROWSER_SEARCH_URL=https://www.bing.com/images/search?q={query}&safeSearch=Strict
# Hard request caps keep one headed-search run bounded. Lower them for a smoke
# test; raise them deliberately only after reviewing ChatGPT-plan usage.
RUNWAY_BROWSER_SEARCH_MAX_QUERIES=6
RUNWAY_BROWSER_SEARCH_RESULTS_PER_QUERY=3
RUNWAY_BROWSER_SEARCH_MAX_RESULTS=18
# Keep the learned primary channel topic dominant while rotating through
# explicit creator-approved secondary topics. Leave secondary topics blank
# for channels that should follow their historical topic distribution only.
RUNWAY_DISCOVERY_PRIMARY_TOPIC_QUERY_SHARE=0.8
RUNWAY_DISCOVERY_SECONDARY_TOPICS=

# Optional custom search-provider adapter. Leave blank unless a compatible
# provider endpoint has been selected and integrated.
RUNWAY_SEARCH_API_URL=
RUNWAY_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Image quality and duplicate protection
# -----------------------------------------------------------------------------
RUNWAY_MINIMUM_IMAGE_DIMENSION=480
RUNWAY_MAXIMUM_IMAGE_BYTES=20971520
# Decoded-size limit for downloaded images (40 megapixels).
RUNWAY_MAXIMUM_IMAGE_PIXELS=40000000
RUNWAY_DUPLICATE_PERCEPTUAL_THRESHOLD=0.94
RUNWAY_DUPLICATE_SEMANTIC_THRESHOLD=0.99
RUNWAY_CAPTION_DUPLICATE_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# YouTube publishing credentials
# -----------------------------------------------------------------------------
# No passwords, cookies, API tokens, or Google credentials belong here. The
# guarded publisher uses data/browser-profile/publisher and manual sign-in in
# ordinary Google Chrome with the Qlob Editor account. Keep that profile local
# and ignored by Git. Never lower Google account security to make sign-in work.

# -----------------------------------------------------------------------------
# Creator platform connections
# -----------------------------------------------------------------------------
# `live` calls the real YouTube, Instagram, and TikTok APIs. `mock` serves
# fictional demo data and marks the UI with a demo banner; OAuth connect is
# disabled in mock mode.
RUNWAY_PLATFORM_PROVIDER=live
# Base URL used to build OAuth redirect URIs. TikTok and Meta require an HTTPS
# redirect, so those connects need the public edge below (Google still allows
# http://localhost and http://127.0.0.1). Leave blank to default to
# http://127.0.0.1:<api port>.
RUNWAY_OAUTH_REDIRECT_BASE_URL=
# Public edge URL (Tailscale Funnel or equivalent) exposing only /hooks/* and
# /api/platforms/*/oauth/callback to the internet. Required for TikTok connect
# and for platform webhooks; without it local mode simply polls. Must be a
# valid https:// URL. `runway doctor platforms --check-edge` GETs
# {RUNWAY_PUBLIC_EDGE_URL}/hooks/health.
RUNWAY_PUBLIC_EDGE_URL=
# Where the browser is sent after an OAuth callback. Leave blank to default to
# http://127.0.0.1:<web port>.
RUNWAY_WEB_BASE_URL=
# Google OAuth client for the YouTube Data + Analytics APIs.
RUNWAY_YOUTUBE_CLIENT_ID=
RUNWAY_YOUTUBE_CLIENT_SECRET=
# Adds youtube.force-ssl to the consent request so comment replies can post.
RUNWAY_YOUTUBE_ENGAGE_SCOPES=false
# Review state of the Google OAuth app: unverified, verified or audited. It only
# gates publishing on hosted installs; a local owner install is always allowed.
RUNWAY_YOUTUBE_APP_STATUS=unverified
# True once Google admits the project to the YouTube posts API pilot. When true
# the enable-publishing consent also asks for youtube.force-ssl so community
# posts can go out; without it only video/short uploads are enabled.
RUNWAY_YOUTUBE_POSTS_API_ACCESS=false
# Instagram app credentials for Instagram API with Instagram Login.
RUNWAY_INSTAGRAM_APP_ID=
RUNWAY_INSTAGRAM_APP_SECRET=
# Review state of the Meta app: development, live_standard or live_advanced.
# Standard access covers the owner's own account; Advanced Access needs Meta
# App Review + Business Verification.
RUNWAY_INSTAGRAM_APP_STATUS=development
# Shared secret you choose for the Meta webhook verification GET; set the same
# value in the dashboard when subscribing https://<edge>/hooks/instagram.
RUNWAY_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Alternative connect path: "Instagram API with Unified Login" (Facebook Login
# for Business). Set all three together; the config id comes from the app's
# Unified-login configuration. These are not carried by secrets.enc.env.
RUNWAY_META_APP_ID=
RUNWAY_META_APP_SECRET=
RUNWAY_INSTAGRAM_UNIFIED_CONFIG_ID=
# TikTok Login Kit credentials.
RUNWAY_TIKTOK_CLIENT_KEY=
RUNWAY_TIKTOK_CLIENT_SECRET=
# Review state of the TikTok app: sandbox, production or audited. Only
# `audited` ever requests video.publish (direct public posts); the inbox-draft
# path uses video.upload and works from a sandbox app.
RUNWAY_TIKTOK_APP_STATUS=sandbox
# Fernet key for the platform token store. Normally generated into
# data/secrets/token.key or carried by secrets.enc.env; set it here only for a
# single-machine install with no private instance. Losing it makes every stored
# token unreadable.
# RUNWAY_TOKEN_KEY=
# Optional Cloudflare R2 bucket for the public media URLs Instagram publishing
# requires (image_url / video_url / cover_url). Without it Instagram stays on
# Reels-plus-manual-workflow (needs_media_host).
RUNWAY_R2_ACCOUNT_ID=
RUNWAY_R2_BUCKET=
RUNWAY_R2_ACCESS_KEY_ID=
RUNWAY_R2_SECRET_ACCESS_KEY=
RUNWAY_R2_ENDPOINT=
# Private instance clone outside the code checkout (docs/PRIVATE_INSTANCE.md):
# instance.toml, secrets.enc.env, the token store and the machine lease live
# there. Prefer it over putting client secrets in this file.
# RUNWAY_INSTANCE_DIR=C:\path\to\runway-instance
# Reply sending stays disabled until this is true AND the connected account
# holds the platform's engage scope.
RUNWAY_INBOX_REPLIES_ENABLED=false
# 0 disables the background sync scheduler (manual sync only).
# Scheduled sync is run by `runway worker` (started by run-runway.ps1); 0 = manual only.
RUNWAY_PLATFORM_SYNC_INTERVAL_MINUTES=0
RUNWAY_PLATFORM_SYNC_MAX_CONTENT_ITEMS=200
RUNWAY_PLATFORM_SYNC_COMMENT_CONTENT_LIMIT=10
RUNWAY_PLATFORM_SYNC_ANALYTICS_DAYS=90

# -----------------------------------------------------------------------------
# Hosted profile (docs/HOSTED_DEPLOY.md). Leave these commented out for local use:
# the local profile needs no login, no cloud account and no paid service.
# -----------------------------------------------------------------------------
# RUNWAY_PROFILE=hosted
# RUNWAY_IDENTITY_PROVIDER=clerk
# Clerk Frontend API URL (the session token issuer); JWKS defaults to
# <issuer>/.well-known/jwks.json.
# RUNWAY_CLERK_ISSUER=https://clerk.example.com
# RUNWAY_CLERK_JWKS_URL=
# Signing secret of the Clerk webhook endpoint /hooks/identity/clerk (whsec_...).
# Keep it in the host's secret store, never in a committed file.
# RUNWAY_CLERK_WEBHOOK_SECRET=
# Browser origin(s) of the web app; also the accepted `azp` values by default.
# RUNWAY_WEB_ORIGINS=https://app.example.com
# RUNWAY_CLERK_AUTHORIZED_PARTIES=
# Runway role for members after the first owner: viewer, editor or approver.
# RUNWAY_HOSTED_DEFAULT_MEMBER_ROLE=viewer
# RUNWAY_FORWARDED_ALLOW_IPS=127.0.0.1
# RUNWAY_RATE_LIMIT_IP_PER_MINUTE=300
# RUNWAY_RATE_LIMIT_PRINCIPAL_PER_MINUTE=120
# RUNWAY_QUOTA_STORAGE_BYTES=1073741824
# RUNWAY_QUOTA_CONNECTED_ACCOUNTS=3
# RUNWAY_QUOTA_POSTS_PER_DAY=10
# RUNWAY_QUOTA_API_REQUESTS_PER_MINUTE=120
# Operator switch checked before every platform-mutating send: inbox replies, the
# browser publisher and the publishing engine (both profiles; 409 publishing_paused).
# RUNWAY_PUBLISHING_PAUSED=false
# Database token store (spec 05 section 3). Hosted always uses it; a local
# owner opts in with RUNWAY_TOKEN_STORE=database. The versioned keyring is
# "v2:<base64-32B>,v1:<base64-32B>": the first entry encrypts, every entry
# decrypts, so a rotation keeps old rows readable until `runway tokens
# rewrap` moves them. Rotate: add the new key first, rewrap, then drop the
# old one. Generate a key with `openssl rand -base64 32`.
# RUNWAY_TOKEN_STORE=
# RUNWAY_TOKEN_KEYS=
# Meta app for Instagram unified login and the Meta platform hooks
# (/hooks/meta/*: deauthorize + data-deletion callbacks).
# RUNWAY_META_APP_ID=
# RUNWAY_META_APP_SECRET=
# RUNWAY_INSTAGRAM_UNIFIED_CONFIG_ID=

# ----------------------------------------------------------- agent interface
# API keys (`runway keys create`) and the MCP server (`runway mcp`); see
# docs/AGENT_API.md. With this true, the unauthenticated loopback API refuses
# writes except the legacy routes listed in runway.auth.request_policy, so an
# agent must send a scoped `Authorization: Bearer rwy_...` key.
RUNWAY_LOCAL_REQUIRE_KEY_FOR_WRITES=false
# Limits applied to each API key separately.
RUNWAY_API_KEY_RATE_LIMIT_PER_MINUTE=120
RUNWAY_API_KEY_DAILY_POST_CAP=50
RUNWAY_API_KEY_DEFAULT_RELEASE_CAP=5
# Outbound webhooks never reach loopback or private addresses unless this is
# true (local profile only; hosted always refuses them).
RUNWAY_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
RUNWAY_WEBHOOK_TIMEOUT_SECONDS=10
