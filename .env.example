# LeeWay environment template
# Copy this file to .env and replace only the values you intend to use.
# Never commit .env, API keys, passwords, cookies, or browser-profile data.

# -----------------------------------------------------------------------------
# Channel and schedule
# -----------------------------------------------------------------------------
LEWAY_PRODUCT_NAME=LeeWay
LEWAY_CHANNEL_NAME=Qlob
LEWAY_CHANNEL_HANDLE=Qlob
LEWAY_TIMEZONE=America/Toronto
LEWAY_DEFAULT_POST_TIME=10:00
LEWAY_PLANNING_HORIZON_DAYS=10
LEWAY_POSTS_PER_DAY=1
LEWAY_DUPLICATE_WINDOW_DAYS=180
LEWAY_APPROVAL_REQUIRED=true

# Keep false. The current publisher creates only LeeWay's internal schedule and
# does not send posts to YouTube. A real publisher must be implemented and tested
# before this setting can have any external effect.
LEWAY_PUBLISHING_ENABLED=false

# -----------------------------------------------------------------------------
# Local storage and servers
# -----------------------------------------------------------------------------
LEWAY_DATA_DIR=data
LEWAY_HOST=127.0.0.1
LEWAY_API_PORT=8000
LEWAY_WEB_PORT=3000
NEXT_PUBLIC_LEEWAY_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Historical YouTube capture
# -----------------------------------------------------------------------------
# Capture uses a visible Chromium window and a persistent local browser profile.
# Google/YouTube passwords are deliberately not environment variables.
LEWAY_CAPTURE_SCROLL_DELAY_MS=1800
LEWAY_CAPTURE_IDLE_CYCLES_BEFORE_STOP=5
LEWAY_CAPTURE_CHECKPOINT_EVERY=10

# -----------------------------------------------------------------------------
# ChatGPT-plan Codex analysis and caption generation
# -----------------------------------------------------------------------------
# Codex runs through the official project-local CLI and reuses `codex login`.
# LeeWay requires "Logged in using ChatGPT", strips API-key environment values,
# serializes jobs, and stops on authentication or included-usage-limit errors.
LEWAY_AGENT_RUNTIME=codex
LEWAY_CODEX_CLI_PATH=
LEWAY_CODEX_MODEL=gpt-5.6-luna
LEWAY_CODEX_REASONING_EFFORT=low
LEWAY_CODEX_TIMEOUT_SECONDS=300
# Five posts per structured request reduces ChatGPT-plan usage overhead while
# keeping image-to-post mapping small enough for reliable visual annotation.
LEWAY_ANALYSIS_BATCH_SIZE=5

# Optional explicit paid API runtime. LeeWay never falls back to it. Leave these
# blank for the ChatGPT-plan Codex configuration.
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Image discovery
# -----------------------------------------------------------------------------
# Experimental headed browser search. It may require manual challenge handling.
# Search results do not automatically grant permission to reuse an image.
LEWAY_ENABLE_BROWSER_SEARCH=false
LEWAY_BROWSER_SEARCH_URL=https://www.bing.com/images/search?q={query}
# Hard request caps keep one headed-search run bounded. Lower them for a smoke
# test; raise them deliberately only after reviewing ChatGPT-plan usage.
LEWAY_BROWSER_SEARCH_MAX_QUERIES=3
LEWAY_BROWSER_SEARCH_RESULTS_PER_QUERY=6
LEWAY_BROWSER_SEARCH_MAX_RESULTS=18

# Optional custom search-provider adapter. Leave blank unless a compatible
# provider endpoint has been selected and integrated.
LEWAY_SEARCH_API_URL=
LEWAY_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Image quality and duplicate protection
# -----------------------------------------------------------------------------
LEWAY_MINIMUM_IMAGE_DIMENSION=480
LEWAY_MAXIMUM_IMAGE_BYTES=20971520
LEWAY_DUPLICATE_PERCEPTUAL_THRESHOLD=0.94
LEWAY_DUPLICATE_SEMANTIC_THRESHOLD=0.99
LEWAY_CAPTION_DUPLICATE_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# YouTube publishing credentials
# -----------------------------------------------------------------------------
# None yet. Real Community-post scheduling is not implemented. The planned
# publisher will use a dedicated persistent browser profile and manual sign-in
# with an Editor (Limited) channel account—not a password or token stored here.
